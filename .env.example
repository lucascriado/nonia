# Conexão com o PostgreSQL (obrigatória)
# Em produção (Coolify), aponte para o serviço de banco interno, ex.:
# postgresql://postgres:senha@postgresql-database-xxxx:5432/postgres
DATABASE_URL=postgresql://nonia:nonia@localhost:5432/nonia

# Porta do servidor Next (opcional, padrão 3000)
# PORT=3000

# URL pública da aplicação (opcional).
# Usada só para montar o link de convite; sem ela, o host da requisição vale.
# APP_URL=https://nonia.app

# Não existe AUTH_SECRET: a sessão é um token aleatório opaco guardado no
# banco (apenas o SHA-256 dele), não um JWT assinado. Não há nada para assinar.
